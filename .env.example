# LokMC — Environment Configuration
# Copy this to .env and fill in production values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────────────
LOKMC_DEBUG=true
LOKMC_HOST=0.0.0.0
LOKMC_PORT=8443
LOKMC_ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Database ─────────────────────────────────────────────────
# SQLCipher encryption key — use a long random string in production
LOKMC_DB_KEY=change-me-in-production

# ── JWT ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
LOKMC_JWT_SECRET=change-me-in-production

# ── Docker ───────────────────────────────────────────────────
LOKMC_DOCKER_BASE_URL=unix:///var/run/docker.sock
